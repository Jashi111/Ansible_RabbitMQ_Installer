#####################################
# CLUSTERING CONFIGURATION
#####################################

# Enable classic peer discovery for manual node list
cluster_formation.peer_discovery_backend = rabbit_peer_discovery_classic_config

# Define peer nodes in the cluster (use actual hostnames or shortnames as shown by `hostname -s`)
cluster_formation.classic_config.nodes.1 = rabbit@{{ HOST_1 }}
cluster_formation.classic_config.nodes.2 = rabbit@{{ HOST_2 }}

# (Optional) Node type - disc means durable, ram is volatile (disc is recommended)
# node_type = disc

#####################################
# HIGH AVAILABILITY / FAILOVER
#####################################

# Handle network partitions automatically (heals cluster if one node drops temporarily)
cluster_partition_handling = autoheal

# Automatically create quorum queues unless otherwise specified
default_queue_type = quorum

# (Optional) Timeouts and heartbeat tuning
# consumer_timeout = 30s
# heartbeat = 60

#####################################
# LOGGING AND DIAGNOSTICS
#####################################

# Log level: info, warning, error, debug
log.default.level = info

# Log to file (default location /var/log/rabbitmq/)
log.file = true
log.file.level = info

# (Optional) Rotate logs
log.file.rotation.size = 10485760
log.file.rotation.count = 5

#####################################
# MANAGEMENT PLUGIN / METRICS
#####################################

# Enable RabbitMQ management plugin (dashboard on :15672)
management.listener.port = 15672
management.listener.ssl = false

# Enable Prometheus metrics endpoint (useful for Grafana)
prometheus.return_per_object_metrics = true

#####################################
# NETWORK & PORTS
#####################################

# Default AMQP port
listeners.tcp.default = 5672

# Loopback users restriction (allows guest user from outside only if this is removed)
loopback_users = none

#####################################
# SECURITY / AUTHENTICATION
#####################################

# Set default user and password (change this in production!)
#default_user = admin
#default_pass = strongpassword

# Allow guest login remotely (not recommended for production)
# loopback_users.guest = false

# Enable TLS if needed (disabled by default)
# listeners.ssl.default = 5671
# ssl_options.cacertfile = /path/to/ca_certificate.pem
# ssl_options.certfile = /path/to/server_certificate.pem
# ssl_options.keyfile = /path/to/server_key.pem
# ssl_options.verify = verify_peer
# ssl_options.fail_if_no_peer_cert = true
